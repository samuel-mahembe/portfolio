---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import PaymentStream from '../components/lab/PaymentStream';
import { site, skills, education, certifications } from '../data/site';
import { withBase } from '../lib/paths';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const linkedinHandle = site.linkedin.replace('https://www.', '');
const githubHandle = site.github.replace('https://', '');
---

<BaseLayout>
  <main id="main">
    <Hero />

    <SectionShell id="about" label="01.about" heading="About">
      <div data-reveal class="space-y-5">
        <p class="type-body">
          I started out building enterprise applications at TelOne Zimbabwe, then spent three years at Econet Wireless
          Zimbabwe working across backend, frontend, APIs, databases, and mobile. Much of that work sat close to
          revenue: recharge platforms, voucher systems, and the transaction data behind them.
        </p>
        <p class="type-body">
          Supporting dashboards and data models at Econet showed me how much depends on the data underneath. That is
          the direction I am moving in now: pipelines, data models, and cloud data platforms, built with the same care
          for reliability as a payment system.
        </p>
        <p class="text-ink max-w-(--measure) font-medium">{site.availability}</p>
      </div>
    </SectionShell>

    <SectionShell id="work" label="02.selected.work" heading="Selected Work">
      <div class="space-y-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </SectionShell>

    <SectionShell id="experience" label="03.experience" heading="Experience">
      <ol class="timeline">
        {experience.map((entry) => <ExperienceEntry entry={entry} />)}
      </ol>
    </SectionShell>

    <SectionShell id="skills" label="04.skills" heading="Skills, Education, Certifications">
      <div class="space-y-12">
        <div data-reveal>
          <h3 class="type-h3">Skills</h3>
          <dl class="mt-4 space-y-3">
            {
              skills.map((skill) => (
                <div class="grid gap-x-6 sm:grid-cols-[11rem_1fr]">
                  <dt class="type-label pt-1">{skill.group}</dt>
                  <dd class="text-muted">{skill.items}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div data-reveal class="grid gap-12 lg:grid-cols-2 lg:gap-8">
          <div>
            <h3 class="type-h3">Education</h3>
            <ul class="mt-4 space-y-5">
              {
                education.map((item) => (
                  <li>
                    <p class="text-ink">{item.degree}</p>
                    <p class="text-muted">{item.school}</p>
                    <p class="type-label mt-1">{item.dates}</p>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="type-h3">Certifications</h3>
            <ul class="mt-4 space-y-5">
              {
                certifications.map((item) => (
                  <li>
                    <p class="text-ink">{item.name}</p>
                    <p class="text-muted">{item.issuer}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </SectionShell>

    <SectionShell id="lab" label="05.lab" heading="Payment stream simulator">
      <p data-reveal class="type-label text-accent!">Simulated. All transactions are fake and generated in your browser.</p>
      <p data-reveal class="type-body mt-3">
        A live feed of made-up payment transactions. Each one gets a risk score from a simple rules and logistic-style
        function, and flagged transactions show the reason.
      </p>
      <div class="mt-8">
        <PaymentStream client:visible caseStudyHref={withBase('projects/payflow/')} />
      </div>
    </SectionShell>

    <SectionShell id="contact" label="06.contact" heading="Get in touch">
      <p data-reveal class="type-body">
        I am open to full-time Software Engineering and Data Engineering roles. Email is the best way to reach me.
      </p>
      <ul data-reveal class="mt-8 space-y-3">
        <li class="flex flex-wrap items-baseline gap-x-4">
          <span class="type-label w-20">Email</span>
          <a class="link min-w-0 break-all" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li class="flex flex-wrap items-baseline gap-x-4">
          <span class="type-label w-20">LinkedIn</span>
          <a class="link min-w-0 break-all" href={site.linkedin}>{linkedinHandle}</a>
        </li>
        <li class="flex flex-wrap items-baseline gap-x-4">
          <span class="type-label w-20">GitHub</span>
          <a class="link min-w-0 break-all" href={site.github}>{githubHandle}</a>
        </li>
      </ul>
    </SectionShell>
  </main>
</BaseLayout>
